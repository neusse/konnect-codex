{
  "description": "Contextual KiCad workflow and IPC readiness guidance for Konnect.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "konnect-codex hook user-prompt",
            "timeout": 5,
            "statusMessage": "Checking for a Konnect workflow"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__konnect__(place_component|move_component|rotate_component|delete_component|update_pcb_from_schematic|route_trace|add_via|delete_trace|modify_trace|route_differential_pair|route_pad_to_pad|add_zone|add_copper_pour|refill_zones|autoroute)$",
        "hooks": [
          {
            "type": "command",
            "command": "konnect-codex hook pre-pcb-ipc",
            "timeout": 5,
            "statusMessage": "Checking KiCad IPC prerequisites"
          }
        ]
      }
    ]
  }
}
